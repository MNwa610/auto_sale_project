# Пример значений. Spring Boot не читает .env автоматически: экспортируйте переменные.
DB_URL=jdbc:postgresql://localhost:5432/auto_sale_kr3
DB_USER=carmarket
DB_PASSWORD=replace_with_local_password
SERVER_PORT=8080
# Обязательно замените результатом openssl rand -base64 32 (не коммитьте настоящий ключ).
JWT_SECRET_BASE64=replace_with_generated_base64_key
# Явное создание первого администратора; после первого запуска отключить.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=
