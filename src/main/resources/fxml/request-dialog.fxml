<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="carmarket.controller.RequestDialogController"
      spacing="10" prefWidth="580" minWidth="480" styleClass="dialog-root">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Пользователь"/>
    <ComboBox fx:id="userBox" maxWidth="Infinity" promptText="Выберите пользователя"/>
    <Label text="Автомобиль"/>
    <ComboBox fx:id="carBox" maxWidth="Infinity" promptText="Выберите автомобиль"/>
    <HBox spacing="8"><Label text="Статус:"/><Label fx:id="statusLabel"/></HBox>
    <Label text="Сообщение (не более 1000 символов)"/>
    <TextArea fx:id="messageArea" wrapText="true" prefRowCount="5" VBox.vgrow="ALWAYS"/>
    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="form-actions">
        <Button text="Сохранить" onAction="#onSave" defaultButton="true" styleClass="primary-button"/>
        <Button text="Отмена" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</VBox>
