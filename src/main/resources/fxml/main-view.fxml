<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="carmarket.controller.MainController"
            styleClass="root-pane"
            minWidth="920" minHeight="560">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <top>
        <VBox spacing="8">
            <Label text="Маркетплейс автомобилей с пробегом" styleClass="title-label"/>
            <FlowPane hgap="8" vgap="8" styleClass="toolbar">
                <Button text="Обновить" onAction="#onRefresh"/>
            </FlowPane>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="main-tabs">
            <Tab text="Заявки" closable="false">
                <VBox spacing="8" maxHeight="Infinity" styleClass="tab-content">
                    <FlowPane hgap="8" vgap="8" styleClass="toolbar">
                        <Button text="Добавить" onAction="#onAddRequest" styleClass="primary-button"/>
                        <Button text="Изменить" onAction="#onEditRequest"/>
                        <Button text="Удалить" onAction="#onDeleteRequest" styleClass="danger-button"/>
                        <Button text="Сменить статус" onAction="#onChangeStatus"/>
                        <Button text="Подробнее" onAction="#onRequestDetails"/>
                        <Button text="Экспорт" onAction="#onExportRequests"/>
                    </FlowPane>
                    <FlowPane hgap="8" vgap="8" styleClass="filter-bar">
                        <Label text="Поиск"/>
                        <TextField fx:id="requestSearchField" promptText="ФИО, марка, модель или сообщение"
                                   prefWidth="300" minWidth="180" onAction="#onApplyRequests"/>
                        <Label text="Статус"/>
                        <ComboBox fx:id="requestStatusBox" prefWidth="140"/>
                        <Label text="Цена от"/>
                        <TextField fx:id="minPriceField" prefWidth="110" onAction="#onApplyRequests"/>
                        <Label text="до"/>
                        <TextField fx:id="maxPriceField" prefWidth="110" onAction="#onApplyRequests"/>
                    </FlowPane>
                    <FlowPane hgap="8" vgap="8" styleClass="filter-bar">
                        <Label text="Сортировать по"/>
                        <ComboBox fx:id="requestSortBox" prefWidth="190"/>
                        <ComboBox fx:id="requestDirectionBox" prefWidth="180"/>
                        <Button fx:id="applyRequestsButton" text="Применить" onAction="#onApplyRequests"
                                styleClass="primary-button"/>
                        <Button fx:id="resetRequestsButton" text="Сбросить" onAction="#onResetRequests"/>
                    </FlowPane>
                    <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS" minHeight="180">
                        <placeholder><Label text="Нет заявок для отображения"/></placeholder>
                        <columns>
                            <TableColumn fx:id="idColumn" text="№" prefWidth="60" minWidth="50"/>
                            <TableColumn fx:id="userColumn" text="Пользователь" prefWidth="180" minWidth="120"/>
                            <TableColumn fx:id="carColumn" text="Автомобиль" prefWidth="180" minWidth="120"/>
                            <TableColumn fx:id="requestPriceColumn" text="Цена автомобиля, ₽" prefWidth="150" minWidth="110"/>
                            <TableColumn fx:id="requestMileageColumn" text="Пробег, км" prefWidth="110" minWidth="90"/>
                            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="120" minWidth="100"/>
                            <TableColumn fx:id="messageColumn" text="Сообщение" prefWidth="260" minWidth="140"/>
                            <TableColumn fx:id="createdAtColumn" text="Дата создания" prefWidth="150" minWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="Автомобили" closable="false">
                <VBox spacing="8" maxHeight="Infinity" styleClass="tab-content">
                    <FlowPane hgap="8" vgap="8" styleClass="toolbar">
                        <Button text="Добавить" onAction="#onAddCar" styleClass="primary-button"/>
                        <Button text="Изменить" onAction="#onEditCar"/>
                        <Button text="Удалить" onAction="#onDeleteCar" styleClass="danger-button"/>
                        <Button text="Заявки на автомобиль" onAction="#onCarRequests"/>
                        <Button text="Экспорт" onAction="#onExportCars"/>
                    </FlowPane>
                    <FlowPane hgap="8" vgap="8" styleClass="filter-bar">
                        <Label text="Поиск"/>
                        <TextField fx:id="carSearchField" promptText="Марка, модель, продавец или VIN"
                                   prefWidth="280" minWidth="180" onAction="#onApplyCars"/>
                        <Label text="Сортировать по"/>
                        <ComboBox fx:id="carSortBox" prefWidth="180"/>
                        <ComboBox fx:id="carDirectionBox" prefWidth="170"/>
                        <Button fx:id="applyCarsButton" text="Применить" onAction="#onApplyCars"
                                styleClass="primary-button"/>
                        <Button fx:id="resetCarsButton" text="Сбросить" onAction="#onResetCars"/>
                    </FlowPane>
                    <TableView fx:id="carsTable" VBox.vgrow="ALWAYS" minHeight="180">
                        <placeholder><Label text="Нет автомобилей для отображения"/></placeholder>
                        <columns>
                            <TableColumn fx:id="brandColumn" text="Марка" prefWidth="110" minWidth="80"/>
                            <TableColumn fx:id="modelColumn" text="Модель" prefWidth="130" minWidth="90"/>
                            <TableColumn fx:id="yearColumn" text="Год" prefWidth="70" minWidth="60"/>
                            <TableColumn fx:id="mileageColumn" text="Пробег, км" prefWidth="100" minWidth="80"/>
                            <TableColumn fx:id="priceColumn" text="Цена, ₽" prefWidth="130" minWidth="90"/>
                            <TableColumn fx:id="carStatusColumn" text="Статус" prefWidth="130" minWidth="100"/>
                            <TableColumn fx:id="sellerColumn" text="Продавец" prefWidth="180" minWidth="120"/>
                            <TableColumn fx:id="vinColumn" text="VIN" prefWidth="180" minWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="Пользователи" closable="false">
                <VBox spacing="8" maxHeight="Infinity" styleClass="tab-content">
                    <FlowPane hgap="8" vgap="8" styleClass="toolbar">
                        <Button text="Добавить" onAction="#onAddUser" styleClass="primary-button"/>
                        <Button text="Изменить" onAction="#onEditUser"/>
                        <Button text="Удалить" onAction="#onDeleteUser" styleClass="danger-button"/>
                        <Button text="Автомобили и заявки" onAction="#onUserRelations"/>
                        <Button text="Экспорт" onAction="#onExportUsers"/>
                    </FlowPane>
                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" minHeight="180">
                        <placeholder><Label text="Нет пользователей для отображения"/></placeholder>
                        <columns>
                            <TableColumn fx:id="fullNameColumn" text="ФИО" prefWidth="280" minWidth="160"/>
                            <TableColumn fx:id="loginColumn" text="Логин" prefWidth="200" minWidth="120"/>
                            <TableColumn fx:id="roleColumn" text="Роль" prefWidth="180" minWidth="100"/>
                            <TableColumn fx:id="registeredAtColumn" text="Дата регистрации" prefWidth="180" minWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab fx:id="statisticsTab" text="Статистика" closable="false" onSelectionChanged="#onStatisticsSelected">
                <fx:include fx:id="statisticsView" source="statistics-view.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
