<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="carmarket.controller.StatisticsController" spacing="12">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Статистика по всей базе" styleClass="title-label"/>
        <Button fx:id="refreshStatisticsButton" text="Обновить" onAction="#refresh"/>
    </HBox>
    <Label text="Поиск и фильтры таблиц не ограничивают эти показатели." wrapText="true"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="16">
            <padding><Insets top="8" right="12" bottom="8" left="0"/></padding>
            <GridPane hgap="24" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="160"/>
                </columnConstraints>
                <Label text="Пользователей" GridPane.rowIndex="0"/>
                <Label fx:id="totalUsersLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Автомобилей" GridPane.rowIndex="1"/>
                <Label fx:id="totalCarsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Заявок" GridPane.rowIndex="2"/>
                <Label fx:id="totalRequestsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Средняя цена автомобиля" GridPane.rowIndex="3"/>
                <Label fx:id="averagePriceLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Средний пробег" GridPane.rowIndex="4"/>
                <Label fx:id="averageMileageLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Минимальная цена автомобиля" GridPane.rowIndex="5"/>
                <Label fx:id="minPriceLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                <Label text="Максимальная цена автомобиля" GridPane.rowIndex="6"/>
                <Label fx:id="maxPriceLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                <Label text="Доля одобренных заявок" GridPane.rowIndex="7"/>
                <Label fx:id="approvedPercentageLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            </GridPane>
            <Label text="Заявки по статусам" styleClass="title-label"/>
            <GridPane hgap="24" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="160"/>
                </columnConstraints>
                <Label text="Новые" GridPane.rowIndex="0"/>
                <Label fx:id="newRequestsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="В работе" GridPane.rowIndex="1"/>
                <Label fx:id="inProgressRequestsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Одобренные" GridPane.rowIndex="2"/>
                <Label fx:id="approvedRequestsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Отклонённые" GridPane.rowIndex="3"/>
                <Label fx:id="rejectedRequestsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Отменённые" GridPane.rowIndex="4"/>
                <Label fx:id="cancelledRequestsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </GridPane>
            <Label text="Автомобили по статусам" styleClass="title-label"/>
            <GridPane hgap="24" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="260" hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="160"/>
                </columnConstraints>
                <Label text="Доступные" GridPane.rowIndex="0"/>
                <Label fx:id="availableCarsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Зарезервированные" GridPane.rowIndex="1"/>
                <Label fx:id="reservedCarsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Проданные" GridPane.rowIndex="2"/>
                <Label fx:id="soldCarsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="В архиве" GridPane.rowIndex="3"/>
                <Label fx:id="archivedCarsLabel" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>
        </VBox>
    </ScrollPane>
</VBox>
